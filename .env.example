# Copy this file to ".env" for local testing. On Vercel, add these in
# Project -> Settings -> Environment Variables instead. NEVER commit a real .env file.

# Contact form (sent with Resend: https://resend.com)
RESEND_API_KEY=
# The inbox that receives inquiries (use the email you signed up to Resend with)
CONTACT_TO_EMAIL=
# Optional. Default is the Resend test sender.
# RESEND_FROM=Portfolio Form <onboarding@resend.dev>
